#!/usr/bin/env bash
#MISE description="Ask a question"
#MISE alias="q"
#MISE raw=true
#USAGE arg "[prompt]" help="The prompt"
#USAGE flag "-f --file... <file>" help="Include file contents as context (repeatable)"
#USAGE flag "-c --clipboard" help="Include clipboard contents as context"
#USAGE flag "-m --model <model>" help="Provider-qualified model (e.g. openai-codex/gpt-5.5)" required=#true
#USAGE flag "--provider <provider>" help="Provider prefix for unqualified model values"
#USAGE flag "--continue" help="Continue the latest ask session"
#USAGE flag "-v --verbose" help="Show debug info"
#USAGE example "ask q -m openai-codex/gpt-5.5 'What is a mutex?'" header="Direct question"
#USAGE example "echo 'some text' | ask q -m openai-codex/gpt-5.5 'Summarize this'" header="Pipe context"
#USAGE example "ask q -m openai-codex/gpt-5.5 -f error.log 'Explain this error'" header="File context"
#USAGE example "ask q -m openai-codex/gpt-5.5 'Quick answer'" header="Model selection"
#USAGE example "shimmer web fetch URL | ask q -m openai-codex/gpt-5.5 'What does this page say?'" header="Web page Q&A"
set -euo pipefail

source "${MISE_CONFIG_ROOT}/lib/sessions.sh"
source "${MISE_CONFIG_ROOT}/lib/clipboard.sh"
source "${MISE_CONFIG_ROOT}/lib/ui.sh"

# --- Read inputs ---

PROMPT=""
FILES=()
HAS_FILES="false"
CLIPBOARD="false"
MODEL=""
PROVIDER=""
VERBOSE="false"
CONTINUE_LATEST="false"

# Optional #USAGE values inherit stale usage_* env vars from parent mise
# tasks. Parse raw argv instead so only flags/args passed to this invocation
# affect ask behavior.
while [[ $# -gt 0 ]]; do
  case "$1" in
    --)
      shift
      if [[ $# -gt 0 ]]; then
        PROMPT="$*"
      fi
      break
      ;;
    -f|--file)
      [[ $# -lt 2 ]] && { echo "error: $1 requires a value" >&2; exit 1; }
      FILES+=("$2")
      HAS_FILES="true"
      shift 2
      ;;
    --file=*)
      FILES+=("${1#--file=}")
      HAS_FILES="true"
      shift
      ;;
    -c|--clipboard)
      CLIPBOARD="true"
      shift
      ;;
    -m|--model)
      [[ $# -lt 2 ]] && { echo "error: $1 requires a value" >&2; exit 1; }
      MODEL="$2"
      shift 2
      ;;
    --model=*)
      MODEL="${1#--model=}"
      shift
      ;;
    --provider)
      [[ $# -lt 2 ]] && { echo "error: $1 requires a value" >&2; exit 1; }
      PROVIDER="$2"
      shift 2
      ;;
    --provider=*)
      PROVIDER="${1#--provider=}"
      shift
      ;;
    --continue)
      CONTINUE_LATEST="true"
      shift
      ;;
    -v|--verbose)
      VERBOSE="true"
      shift
      ;;
    *)
      if [[ -z "$PROMPT" ]]; then
        PROMPT="$1"
      else
        PROMPT+=" $1"
      fi
      shift
      ;;
  esac
done

# Always read piped stdin if available
PIPED=""
if [[ ! -t 0 ]]; then
  PIPED=$(cat)
fi

# Piped input: becomes prompt if no arg, or context if prompt arg given
if [[ -z "${PROMPT}" && -n "${PIPED}" ]]; then
  PROMPT="${PIPED}"
  PIPED=""  # consumed as prompt, not context
fi

MODEL=$(resolve_model "$MODEL" "$PROVIDER") || exit 1

# --- Gather context from sources ---

context=""

# Piped input as context (when prompt arg was also given)
if [[ -n "${PIPED}" ]]; then
  context+="${PIPED}"
fi

for file in ${FILES[@]+"${FILES[@]}"}; do
  [[ ! -f "${file}" ]] && { echo "error: file not found: ${file}" >&2; exit 1; }
  file_content=$(cat "${file}")
  if [[ -n "${context}" ]]; then
    context+=$'\n\n---\n\n'
  fi
  context+="File: ${file}"$'\n\n'"${file_content}"
done

clip_content=""
if [[ "${CLIPBOARD}" == "true" ]]; then
  clip_content=$(get_clipboard) || exit 1
  [[ -z "${clip_content}" ]] && { echo "error: clipboard is empty" >&2; exit 1; }
  if [[ -n "${context}" ]]; then
    context+=$'\n\n---\n\n'
  fi
  context+="Clipboard:"$'\n\n'"${clip_content}"
fi

# --- Resolve prompt if still empty ---

if [[ -z "${PROMPT}" ]]; then
  # Interactive: prompt the user
  if [[ -t 0 ]]; then
    placeholder="What would you like to ask?"
    if [[ "${HAS_FILES}" == "true" && "${CLIPBOARD}" == "true" ]]; then
      placeholder="What would you like to ask about these?"
    elif [[ "${HAS_FILES}" == "true" ]]; then
      placeholder="What would you like to ask about this file?"
    elif [[ "${CLIPBOARD}" == "true" ]]; then
      placeholder="What would you like to ask about this?"
    fi
    PROMPT=$(prompt_user "${placeholder}")
  fi
  [[ -z "${PROMPT}" ]] && { echo "error: no prompt provided" >&2; exit 1; }
fi

[[ "${VERBOSE}" == "true" ]] && echo "Model: ${MODEL} | Prompt: ${#PROMPT} chars | Context: ${#context} chars | Continue: ${CONTINUE_LATEST}" >&2

# --- Run ---

if [[ -n "${context}" ]]; then
  run_ask_session "$(build_prompt "${PROMPT}" "${context}")" "$MODEL" "$CONTINUE_LATEST"
else
  run_ask_session "${PROMPT}" "$MODEL" "$CONTINUE_LATEST"
fi
